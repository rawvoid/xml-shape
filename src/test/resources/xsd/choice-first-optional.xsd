<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           xmlns="http://example.com/choiceopt"
           targetNamespace="http://example.com/choiceopt"
           elementFormDefault="qualified">

    <xs:element name="Root">
        <xs:complexType>
            <xs:choice>
                <xs:element name="OptionalBranch" type="xs:string" minOccurs="0"/>
                <xs:element name="RequiredBranch" type="xs:string"/>
            </xs:choice>
        </xs:complexType>
    </xs:element>
</xs:schema>
